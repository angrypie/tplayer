{
  "name": "tplayer-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && bunx --bun vite build",
    "check": "ultracite check",
    "cloudflare": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts",
    "cloudflare:apply": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts apply",
    "cloudflare:onboard": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts onboard",
    "cloudflare:plan": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts plan",
    "cloudflare:rollback": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts rollback",
    "cloudflare:test": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts self-test",
    "cloudflare:verify": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts verify",
    "dev": "bunx --bun vite --host --port 3000",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "prepare": "lefthook install",
    "preview": "bunx --bun vite preview --host"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "bencode": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "howler": "^2.2.4",
    "lucide-react": "^1.34.0",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "natsort": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "lefthook": "^2.1.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.6",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  }
}
