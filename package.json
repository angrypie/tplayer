{
  "name": "tplayer-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "benchmark": "bun test server/database.test.ts server/torrent/integration.test.ts src/routes/Playlist/offlineCache.test.ts packages/captions/benchmark/captions.benchmark.test.ts --test-name-pattern 'performance|TTFB' --timeout 30000",
    "build": "tsc -b && bunx --bun vite build && bun run build:server",
    "build:frontend": "tsc -b && bunx --bun vite build",
    "build:server": "bun build --target=bun --external=webtorrent --sourcemap=linked --outdir=build --entry-naming=server.js server/index.ts",
    "check": "ultracite check",
    "cloudflare": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts",
    "cloudflare:apply": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts apply",
    "cloudflare:onboard": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts onboard",
    "cloudflare:plan": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts plan",
    "cloudflare:purge": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts purge-frontend",
    "cloudflare:rollback": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts rollback",
    "cloudflare:test": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts self-test",
    "cloudflare:verify": "bun --env-file=.env.cloudflare run scripts/cloudflare.ts verify",
    "dev": "bunx --bun vite --host --port 3000",
    "dev:server": "TPLAYER_SERVE_FRONTEND=false bun --watch server/index.ts",
    "fix": "ultracite fix",
    "hooks:install": "lefthook install",
    "lint": "ultracite check",
    "preview": "bunx --bun vite preview --host",
    "production:config": "sh scripts/run-production.sh --print-config",
    "service:install": "bun scripts/macos-launchctl.ts install",
    "service:logs": "bun scripts/macos-launchctl.ts logs",
    "service:restart": "bun scripts/macos-launchctl.ts restart",
    "service:start": "bun scripts/macos-launchctl.ts start",
    "service:status": "bun scripts/macos-launchctl.ts status",
    "service:stop": "bun scripts/macos-launchctl.ts stop",
    "start": "sh scripts/run-production.sh",
    "test": "bun test server src packages/captions",
    "test:macos": "bun test scripts/production.integration.test.ts",
    "test:search:live": "bun test integration/live/search-providers.test.ts --timeout 90000",
    "test:search:live:tracker": "TPLAYER_LIVE_TRACKER_TESTS=1 bun test integration/live/search-providers.test.ts --test-name-pattern 'live optional tracker' --timeout 90000",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "hono": "4.13.5",
    "howler": "^2.2.4",
    "lucide-react": "^1.34.0",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "parse-torrent": "11.0.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "webtorrent": "3.0.21",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@couchspeech/client": "file:../couchspeech/Clients/JavaScript",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tplayer/captions": "workspace:*",
    "@types/bun": "1.4.0",
    "@types/howler": "2.2.12",
    "@types/node": "^26.4.0",
    "@types/parse-torrent": "11.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/webtorrent": "3.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "6.2.4",
    "lefthook": "^2.1.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.6",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "trustedDependencies": [
    "lefthook",
    "node-datachannel",
    "utp-native"
  ]
}
