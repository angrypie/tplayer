# Create a scoped token with Cloudflare Tunnel, DNS, and Access application
# read/write permissions. Never commit the real token.
CLOUDFLARE_API_TOKEN=

# Comma-separated Access principals. At least one list is required when the
# onboarding tool creates or manages the TPlayer Access application.
TPLAYER_ACCESS_EMAILS=
TPLAYER_ACCESS_EMAIL_DOMAINS=
